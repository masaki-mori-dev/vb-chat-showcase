<?xml version="1.0" encoding="utf-8"?>
<!-- Web.config の変換プロセスの使用についての詳細については、https://go.microsoft.com/fwlink/?LinkId=125889 を参照してください -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

	<system.web>
		<compilation xdt:Transform="RemoveAttributes(debug)" />

		<!-- 本番は必ず RemoteOnly に固定する。

		     Web.config 本体も RemoteOnly なので、これは二重掛けで、通常は何も変えない。
		     それでも残しているのは、誰かが本体を Off にして戻し忘れたときに、
		     本番だけは黙って安全側へ引き戻すため。ここを消すと、本番の安全が
		     「本体を書き換えないこと」だけに頼る形になる。 -->
		<customErrors mode="RemoteOnly" xdt:Transform="Replace" />
	</system.web>

	<!-- configurationの直下に system.webServer を丸ごと差し込む -->
	<system.webServer xdt:Transform="InsertIfMissing">
		<defaultDocument>
			<files>
				<clear />
				<add value="Default.aspx" />
			</files>
		</defaultDocument>
		<rewrite xdt:Transform="InsertIfMissing">
			<rules>
				<rule name="http to https">
					<match url="(.*)" />
					<conditions>
						<add input="{HTTPS}" pattern="^OFF$" />
					</conditions>
					<action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
				</rule>
			</rules>
		</rewrite>

		<!-- 「ページが見つかりません」（住所のルール）

		     無い住所・中身を見せないフォルダの住所（403.14）に、
		     IIS の素のエラー画面ではなく、サイトの見た目の NotFound.aspx を中で開いて返す（NotFound.aspx.vb が状態の番号を 404 にする）。
		     ASP.NET が「無い」と判断したもの（無い .aspx・Core/CanonicalUrl.vb が 404 にした実物の住所）は、ここに来る前に
		     アプリ（Global.asax の Application_Error と CanonicalUrl）が自分で NotFound.aspx を出している。
		     【403 は 403.14（フォルダ）だけ】ほかの 403（.config を断る・本番の WAF が保存を止める）は差し替えない。
		     WAF の 403 を差し替えると、止められた POST の本文ごと NotFound.aspx に渡りうる。.config は発行後の確かめの道具が 403 で見ている

		     【existingResponse="Auto"】ページが TrySkipIisCustomErrors を立てて返した 404・503
		     （記事が見つかりません・混み合っています・非常口が閉じている、など）は差し替えない。
		     立てていない 404（ASP.NET の素の404・静的ファイルの404）だけを差し替える。
		     errorMode は書いていない（サーバーの既定＝外からの要求には差し替えた画面、のまま）。

		     【Web.config 本体に書かない理由】本体に <system.webServer> を作ると、この InsertIfMissing が
		     「もう在る」と判断して、本番の https 強制と defaultDocument が黙って消える（「発行・ファイルまわり」の罠）。
		     そのため開発機（IIS Express）には効かない。開発機で試すときは、本体に一時的に書いて、コミットの前に消すこと

		     【本番で 500.19 になったら】ホスティングがこの区画を許していない。本番の Web.config を、
		     発行の前に取っておいたもので上書きして戻す -->
		<httpErrors existingResponse="Auto">
			<remove statusCode="404" subStatusCode="-1" />
			<error statusCode="404" path="/NotFound.aspx" responseMode="ExecuteURL" />
			<remove statusCode="403" subStatusCode="14" />
			<error statusCode="403" subStatusCode="14" path="/NotFound.aspx" responseMode="ExecuteURL" />
		</httpErrors>

		<!-- 静的ファイル（CSS・JS・画像）を、ブラウザに30日ためさせる。

		     これが無いと Cache-Control が出ず、ブラウザは毎回
		     「変わっていないか」をサーバーに聞きに来る（304の往復が毎回起きる）。
		     ためさせることで、その往復ごと消える＝サーバーの負荷が減る。

		     【必ずセットで守ること】
		     ここで長くためさせられるのは、CSS・JS の URL に
		     common.AssetUrl で印が付いていて、直せば必ず別のURLになるから。
		     今後、新しく <link> や <script> で静的ファイルを読み込むときは、
		     必ず AssetUrl を通すこと。通し忘れたファイルは、直しても
		     30日間、利用者に届かなくなる。

		     30日にしてあるのは、1年にしたときの「通し忘れが1年間直せない」
		     リスクを避けるため。往復が消える効果は30日でも1年でも変わらない
		     （常連の再訪はそれよりずっと短い間隔で来るため）。
		     運用が固まったら、この日数を伸ばすのは1行の変更で済む。

		     【注意】.aspx は静的ファイルではないため、この設定の影響を受けない。
		     画面そのものが古いまま貼り付く心配は無い。 -->
		<staticContent>
			<clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
		</staticContent>
	</system.webServer>


	<!-- 接続文字列の変換は置いていない。

	     本番の ID・パスワードをリポジトリにも発行物にも残さないため、接続情報は
	     Web.config 本体から connections.config へ分離し、そのファイルを git と発行の
	     両方から外してある。本番の connections.config は、FTP で個別に設置する。

	     ここへ接続文字列を書き戻さないこと。書いた瞬間に、また平文で git に載る。 -->


	
	

</configuration>