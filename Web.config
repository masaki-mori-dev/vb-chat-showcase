<?xml version="1.0" encoding="utf-8"?>
<!--
  ASP.NET アプリケーションの構成方法の詳細については、
  https://go.microsoft.com/fwlink/?LinkId=169433 を参照してください
  -->
<configuration>


	<!-- 接続文字列は、このファイルには書かない。

	     本番の ID・パスワードを git にも発行物にも残さないため、接続情報は
	     connections.config へ分離し、ここからは configSource で参照するだけにしてある。
	     connections.config は .gitignore で除外し、発行対象からも外してあるため、
	     環境ごと（開発機・本番）に手で置く。詳しい理由は connections.config 内のコメントを参照。

	     【注意】configSource を使う要素には、子要素を書いてはいけない（設定エラーになる）。 -->
	<connectionStrings configSource="connections.config" />


	<!-- メールの送り方（エラー報告メール）

	     SMTP の設定（ホスト・ポート・ユーザー名・パスワード・差出人）は、このファイルには書かない。
	     connections.config と同じく mail.config へ分離し、configSource で参照するだけにしてある。
	     mail.config は .gitignore で除外し、.vbproj にも登録しない（＝発行されない）。環境ごとに手で置く。
	       ・本番   … ホスティング先の SMTP（587番・途中から暗号化）
	       ・開発機 … deliveryMethod="SpecifiedPickupDirectory"。送らずに .eml をフォルダへ書き出す

	     【mail.config が無い・壊れていても、サイトは落ちない】（開発機で実測）
	     この設定はメールを送る瞬間にしか読まれないので、困るのはメールだけである。
	     トリップのソルトで一度サイト全体が500になったのは appSettings の file 属性のほうで、
	     あちらは ASP.NET が起動の段階で読むため（事情が違う）。
	     それでも、新しいサーバーでは発行より先に mail.config を置くこと（知らせが届かない時間を作らない）

	     【注意】configSource を使う要素には、子要素を書いてはいけない（設定エラーになる）。
	     mail.config を差し替えると、アプリが再起動する（connections.config と同じ） -->
	<system.net>
		<mailSettings>
			<smtp configSource="mail.config" />
		</mailSettings>
	</system.net>



	<system.web>
		<compilation debug="true" strict="false" explicit="true" targetFramework="4.8" />
		<httpRuntime targetFramework="4.8" />
		<!-- 既定は RemoteOnly（安全側）。
		     エラーの詳細は、サーバー上で見たときだけ表示され、外からは出ない。

		     ここを Off（詳細を誰にでも見せる）にしないのは、変換が不発になったときに
		     どちら側へ転ぶかを安全側に固定するため。以前は逆で、本体が Off、
		     Web.Release.config が RemoteOnly へ塗り替える作りだった。その形だと変換が
		     効かなかったときに本番がエラー全開のまま公開され、しかも見た目では気づけない。

		     開発機の見え方は変わらない。RemoteOnly は「サーバーと同じ機械からの要求には
		     詳細を出す」設定で、ローカルの localhost はまさにそれに当たるため。

		     【注意】Web.Debug.config / Web.Release.config の変換は、発行のときにしか走らない。
		     F5 で起動したローカルに効くのは、この Web.config 本体だけ。 -->
		<customErrors mode="RemoteOnly" />
		<pages>
			<namespaces>
				<add namespace="System.Web.Optimization" />
			</namespaces>
			<controls>
				<add assembly="Microsoft.AspNet.Web.Optimization.WebForms" namespace="Microsoft.AspNet.Web.Optimization.WebForms" tagPrefix="webopt" />
			</controls>
		</pages>
	</system.web>

	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="Antlr3.Runtime" publicKeyToken="eb42632606e9261f" />
				<bindingRedirect oldVersion="0.0.0.0-3.5.0.2" newVersion="3.5.0.2" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" />
				<bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
			</dependentAssembly>
			<!-- SignalR 2.4.3 は Microsoft.Owin 2.1.0 で作られている。穴の知らせのある 2.1.0 から 4.2.3 へ上げたので、古い版を求められても 4.2.3 を使わせる -->
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Owin" publicKeyToken="31bf3856ad364e35" />
				<bindingRedirect oldVersion="0.0.0.0-4.2.3.0" newVersion="4.2.3.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Owin.Host.SystemWeb" publicKeyToken="31bf3856ad364e35" />
				<bindingRedirect oldVersion="0.0.0.0-4.2.3.0" newVersion="4.2.3.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Owin.Security" publicKeyToken="31bf3856ad364e35" />
				<bindingRedirect oldVersion="0.0.0.0-4.2.3.0" newVersion="4.2.3.0" />
			</dependentAssembly>
			<!-- 記事の本文を通す HtmlSanitizer と、その依存。
			     .NET Framework 4.8 は System.Memory などを持っていないので、
			     packages\ に入れた版を必ず使わせる。
			     【版を上げたら、ここの数も直すこと】新しい版の DLL を置いたのに
			     ここが古いままだと、「指定されたファイルが見つかりません」で落ちる -->
			<dependentAssembly>
				<assemblyIdentity name="AngleSharp" publicKeyToken="e83494dcdc6d31ea" />
				<bindingRedirect oldVersion="0.0.0.0-1.7.2.0" newVersion="1.7.2.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" />
				<bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" />
				<bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Numerics.Vectors" publicKeyToken="b03f5f7f11d50a3a" />
				<bindingRedirect oldVersion="0.0.0.0-4.1.6.0" newVersion="4.1.6.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" />
				<bindingRedirect oldVersion="0.0.0.0-6.0.3.0" newVersion="6.0.3.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Collections.Immutable" publicKeyToken="b03f5f7f11d50a3a" />
				<bindingRedirect oldVersion="0.0.0.0-10.0.0.11" newVersion="10.0.0.11" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Text.Encoding.CodePages" publicKeyToken="b03f5f7f11d50a3a" />
				<bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="WebGrease" publicKeyToken="31bf3856ad364e35" />
				<bindingRedirect oldVersion="0.0.0.0-1.6.5135.21930" newVersion="1.6.5135.21930" />
			</dependentAssembly>
		</assemblyBinding>
	</runtime>

	<system.codedom>
		<compilers>
			<compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701" />
			<compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+" />
		</compilers>
	</system.codedom>



	<!-- 【appSettings は空になった】

	     ここにあった4つ（SiteName・CopyrightName・ThemeColor・DefaultIconType）は、
	     すべて DB の SiteSettings テーブルへ移した。窓口はルート直下の SiteSettings クラス。

	     【なぜ Web.config をやめたのか】
	     このファイルを書き換えると、ASP.NET のアプリケーションが再起動する。
	     つまり管理画面から設定を1つ変えるたびに、その時点の在室者が全員切断される。
	     （connections.config の差し替えでアプリが再起動するのと、同じ仕組み）

	     ThemeColor は、名前と用途が食い違っていたため DefaultIconColor へ改名した。
	     用途は「アイコンの初期色」であって、画面全体の配色（Content/theme.css）ではない。

	     このセクション自体を消していないのは、将来ここへ書くべき値
	     （＝アプリの再起動を伴ってよい、起動時にしか読まない値）が出たときに、
	     置き場所がここだと分かるようにしておくため。
	     利用者の操作で変わる値は、ここではなく SiteSettings テーブルへ入れること

	     【トリップのソルトは、ここ（appSettings）に入れないこと】
	     置き場所は App_Data\trip-salt.txt（テキスト1行）で、Chat/TripCode.vb が自分で読む。
	     2026年9月13日（F-1）に一度 <appSettings file="App_Data\secrets.config"> で読み足す形にしたが、
	     **そのファイルがXMLとして1文字壊れると、サイト全体が構成エラー（500）で落ちた**
	     （開発機で実測。トップページも含めて全部。ASP.NET が設定を読む段階で止まるので、
	     TripCode の Try/Catch も届かない）。トリップは飾りなので、壊れても止まるのは
	     トリップだけ、という形に同じ日のうちに戻した。file 属性も configSource も使わない -->
	<appSettings>
	</appSettings>


</configuration>