    <!-- 画像の置き場所の中身を、実行させないための設定。
         【Content にしてあること】発行に含める必要がある。
         このファイルが発行されることで、Uploads\images フォルダそのものも
         本番に作られる（利用者の画像は、そこへ増えていく）。
         中身と理由は、そのファイル自身のコメントにある -->
    <Content Include="Uploads\images\web.config" />
    <!-- 記事の画像の置き場所にも、同じ設定。発行されることで Uploads\articles フォルダも本番に作られる -->
    <Content Include="Uploads\articles\web.config" />
    <!-- プロフィールの画像の置き場所にも、同じ設定（ブログ型の①）。発行されることで Uploads\profiles フォルダも本番に作られる -->
    <Content Include="Uploads\profiles\web.config" />
