<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================
  このフォルダの中身を、絶対に実行させないための設定
  ============================================================

  ブログ型の①（プロフィール）の回で、Uploads/articles/web.config を写して置いた。

  ここには、プロフィールのアイコン・カバーの画像が入る
  （Uploads/profiles/アカウントの番号/GUID.拡張子）。
  記事の画像（Uploads/articles/）とは、根を分けてある——記事の画像は1日1回の片付けが
  「どの記事の本文からも使われていない画像」を消しにいくので、
  同じフォルダに置くと、プロフィールの画像が翌日に全部消える。


  ■ 中身と理由は、Uploads/articles/web.config とまったく同じ

    ・ここへ .aspx が置かれることは無い（受け口が拡張子を利用者に決めさせない）
    ・それでも置いてあるのは、二重の守りだから
    ・**ここへ、これ以上のものを書かないこと**（ロックされたセクションを書くと 500.19）

  くわしい説明は Uploads/articles/web.config の先頭にある。
  片方を直すときは、もう片方も見ること。


  ■ 【Content で .vbproj に登録してある】

  発行に含める必要がある。このファイルが発行されることで、
  Uploads\profiles フォルダそのものが本番に作られる（画像は、そこへ増えていく）。
-->
<configuration>
  <system.webServer>
    <!-- Read だけ許す。Script も Execute も与えない -->
    <handlers accessPolicy="Read" />
  </system.webServer>
</configuration>
